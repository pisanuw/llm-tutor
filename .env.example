# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Who the tutor is and what it teaches is NOT configured here: see courses.yaml
# and ADDING-KNOWLEDGE.md.

# ── Required: Claude API (the running tutor; some pipeline steps) ──────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional model override; default in tutor/config.py is claude-sonnet-4-6.
# CLAUDE_MODEL=claude-sonnet-4-6
# Warm the tutor's prompt cache when a student opens the chat (about $0.27 a
# warm-up, at most one per 50 minutes; agent/turn_stages/cache_warm.py).
# CACHE_PREWARM=true

# ── Required: auth ──────────────────────────────────────────────────────────
# Signs JWT session cookies (HS256). Generate with: openssl rand -hex 32
SECRET_KEY=
# Token access to /admin: paste it into the form at /admin/login, or send the
# X-Admin-Token header from scripts (a token in the URL is not accepted).
ADMIN_TOKEN=changeme-admin-token
# Comma-separated admin emails: they open /admin and bypass the login
# whitelist. No default in code: left empty, nobody can open /admin and,
# with the whitelist on, only whitelisted addresses can log in (boot warns).
ADMIN_EMAILS=

# ── Optional: Google OAuth (leave blank to fall back to magic link only) ─────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional: Resend (magic-link email; blank = dev mode shows URL on page) ──
RESEND_API_KEY=
FROM_EMAIL=tutor@example.edu

# ── Optional: ops alerts + DB self-heal ──────────────────────────────────────
# System-error emails (unhandled 500s, DB outages) go here; default is
# ADMIN_EMAILS. Sent via RESEND_API_KEY; deduped per problem, see tutor/alerts.py.
# ALERT_EMAILS=
# ALERT_COOLDOWN_MINUTES=60
# Supabase Management API creds so the app can un-pause its own database
# (tutor/selfheal.py). Same values as the GitHub Actions secrets; see DEPLOY.md.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
# Sentry error reporting (errors only, no tracing/PII); unset = disabled.
# SENTRY_DSN=

# ── Optional: app/runtime overrides ─────────────────────────────────────────
# BASE_URL=http://localhost:8000
# JWT_EXPIRY_DAYS=7
# MAGIC_LINK_EXPIRY_MINUTES=30
# TUTOR_DB=tutor.db
# Where your course content lives (courses.yaml, curriculum/, persona/, ...);
# default: the repository root. See ADDING-KNOWLEDGE.md.
# TUTOR_CONTENT_DIR=
# Run student code in a sandbox (C++ only; never beside a production database).
# ENABLE_CODE_EXEC=false

# ── Optional: Pipeline ingest tokens ─────────────────────────────────────────
# GitHub token: cloning private course repos (pipeline github), and reading the
# deploy seeds from a private repo's Releases (entrypoint.sh)
GITHUB_TOKEN=
# Discord bot token for discord ingest (pipeline/ingest/discord_api_reader.py)
DISCORD_TOKEN=

# ── Optional: ElevenLabs voice / TTS ("speak this reply" 🔊 button) ──────────
# Both must be set to enable voice; if either is blank the feature is silently
# disabled. API key: ElevenLabs dashboard -> Profile -> API Keys.
# Voice ID: ElevenLabs -> My Voices -> your cloned voice -> Voice ID.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TTS_CACHE_DIR=tts-cache
