#!/bin/sh
# Enforce Conventional Commits format.
# See: https://www.conventionalcommits.org/
#
# Accepted format:  type(scope): subject
# Accepted types:   feat fix chore docs refactor test perf ci style revert

commit_msg=$(cat "$1")

# Allow merge commits and revert commits that git generates automatically
case "$commit_msg" in
  Merge\ *|Revert\ \"*) exit 0 ;;
esac

pattern='^(feat|fix|chore|docs|refactor|test|perf|ci|style|revert)(\([a-z0-9_/-]+\))?: .+'

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "  ERROR: commit message does not follow Conventional Commits."
  echo ""
  echo "  Format : type(scope): short description"
  echo "  Types  : feat  fix  chore  docs  refactor  test  perf  ci  style  revert"
  echo "  Scopes : optional — e.g.  agent  pipeline  auth  db  ui  mastery"
  echo ""
  echo "  Examples:"
  echo "    feat(mastery): add mini-exam gating for learning goals"
  echo "    fix(agent): prevent stale pending exam from blocking new topics"
  echo "    chore: add MIT LICENSE and .gitignore entries"
  echo ""
  echo "  Your message was:"
  echo "    $commit_msg"
  echo ""
  exit 1
fi
